# Finance Dashboard Environment Variables

# API Configuration
VITE_API_BASE_URL=https://query1.finance.yahoo.com

# Refresh Intervals (in milliseconds)
VITE_REFRESH_INTERVAL_CURRENT=30000    # 30 seconds
VITE_REFRESH_INTERVAL_7DAYS=300000     # 5 minutes
VITE_REFRESH_INTERVAL_QUARTER=3600000  # 1 hour

# Cache TTL (in milliseconds)
VITE_CACHE_TTL=30000                   # 30 seconds

# Feature Flags
VITE_ENABLE_AUTO_REFRESH=true
VITE_ENABLE_MOCK_DATA=true

